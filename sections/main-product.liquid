          "@type": "Answer",
          "text": "Prepaid orders ship faster, and easy exchanges are available as per the store policy."
        }
      }
    ]
  }
</script>
<style>
  /* === TRUST BADGE BLOCK STYLING === */
  /* Trust badge ka background box, padding aur border hatane ke liye */
  .product-summary [class*="trust"], 
  .product-summary [class*="badge"] {
    background: transparent !important;
    background-color: transparent !important;
    border: none !important;
    box-shadow: none !important;
    padding: 0 !important;
    margin-bottom: 8px !important; /* Trust badge aur USP ke beech ka gap kam kiya */
  }

  /* Agar trust badge ke andar ki image ke upar koi default margin ho toh use hatane ke liye */
  .product-summary [class*="trust"] img,
  .product-summary [class*="badge"] img {
    margin: 0 auto !important;
    display: block;
  }


  /* === USP BLOCK STYLING === */
  /* USP block ki top spacing khatam karne ke liye taaki wo upar wale block ke close aa jaye */
  .product-summary [class*="product-usp"],
  .product-summary [class*="usp"] {
    margin-top: 0 !important;
    padding-top: 0 !important;
  }

  /* Sirf PC/Desktop ke liye (purana fix + alignment) */
  @media (min-width: 992px) {
    .product-summary [class*="usp"], 
    .product-summary [class*="usp"] span, 
    .product-summary [class*="usp"] a,
    .product-summary [class*="usp"] div {
      white-space: nowrap !important;
      font-size: 12px !important; 
    }

    .product-summary [class*="usp"] {
      display: inline-flex !important;
      align-items: center;
      gap: 4px !important; 
    }
  }
</style>
{% schema %}
{
  "name": "t:sections.main-product.name",
  "class": "product-section spaced-section",
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "vendor",
      "name": "Vendor / Subtitle"
    },
    {
      "type": "text",
      "name": "t:sections.main-product.blocks.text.name",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "default": "Text block",
          "label": "t:sections.main-product.blocks.text.settings.text.label"
        }
      ]
    },
    {
      "type": "collapsible",
      "name": "Collapsible tab",
      "settings": [
        {
          "type": "text",
          "id": "tab_heading",
          "label": "Tab title",
          "default": " Collapsible  title"
        },
        {
          "type": "liquid",
          "id": "tab_content",
          "label": "Tab content (Liquid Code)"
        },
        {
          "type": "checkbox",
          "id": "open_default",
          "label": "Open tab by default",
          "default": false
        }
      ]
    },
    {
      "type": "reviews_collapsible",
      "name": "Reviews collapsible tab",
      "settings": [
        {
          "type": "text",
          "id": "tab_heading",
          "label": "Tab title",
          "default": "Reviews collapsible title"
        }
      ]
    },
    {
      "type": "product-meta",
      "name": "Product meta",
      "settings": [
        {
          "type": "checkbox",
          "id": "hide_category",
          "default": true,
          "label": "Show category"
        },
        {
          "type": "checkbox",
