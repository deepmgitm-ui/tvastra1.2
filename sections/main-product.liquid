{{ 'product-detail.min.css' | asset_url | stylesheet_tag }}
<link rel="stylesheet" href="{{ 'product-page-premium-layout.css' | asset_url | split: '?' | first }}?v=product-sticky-tray-v3">
<link rel="stylesheet" href="{{ 'product-size-row-polish.css' | asset_url | split: '?' | first }}?v=8">
<link rel="stylesheet" href="{{ 'product-media-full-view.css' | asset_url | split: '?' | first }}?v=gallery-controller-v2">
<link rel="stylesheet" href="{{ 'product-share.css' | asset_url | split: '?' | first }}?v=1">
{%- liquid
  assign section_id = section.id  
  assign variant_colors = settings.product_colors | strip_newlines | downcase | split: ','
  assign slides_per_view = 'auto'
  assign direction = 'vertical'
  if section.settings.product_gellery == 'slider-horizontal'
    assign direction = 'horizontal'
    assign slides_per_view = '5'
  endif 
  if section.settings.thumb_slider_placement == 'left' and section.settings.product_gellery == 'slider-vertical'
    assign thumb_slider = ' thumb-left'
  elsif section.settings.thumb_slider_placement == 'right' and section.settings.product_gellery == 'slider-vertical'
    assign thumb_slider = ' thumb-right'
  endif 
  assign group_image = section.settings.enable_variant_group
  assign product_options_downcased = product.selected_or_first_available_variant.options | downcase

  if product.selected_or_first_available_variant.featured_media
    assign seo_media = product.selected_or_first_available_variant.featured_media
  else
    assign seo_media = product.featured_media
  endif
-%} 
<section {% if section.settings.element_id != blank %} id="{{ section.settings.element_id }}"{% endif %} class="section-{{ section.id }} position-relative main-product-page product-page-{{ section.settings.product_page_style }} {{ section.settings.padding_top }} {{ section.settings.padding_bottom }}{% if section.settings.element_class != blank %} {{ section.settings.element_class }}{% endif %}{% if section.settings.section_bg_image != blank %} {{ section.settings.background_position }}{% endif %}{% unless section.settings.zoom_enabled == true %} zoom-disable{% endunless %}" style="{% if section.settings.section_bg_image != blank %}background-image: url({{ section.settings.section_bg_image | image_url }});{% elsif section.settings.section_bg_color != blank %}background-color: {{ section.settings.section_bg_color }};{% endif %}">
  <div class="{{ section.settings.container_type }}">
    <div class="product row">
      {%- if section.settings.product_page_style == 'style-2' -%}
        <div class="col-12 product-gallery{{ thumb_slider }}" id="product-gallery-{{ section.id }}" data-group-image="{{ section.settings.enable_variant_group }}">
          {%- render 'product-media-grid-column',
            section_settings: section.settings, 
            slider_veiw: slides_per_view, 
            direction: direction, 
            group_image: group_image, 
            section_id: section_id,
            product_options_downcased: product_options_downcased  
          -%}
        </div>
        <div class="col-12 product-summary">
          {%- if section.settings.show_content_container == true -%}
          <div class="container">
          {%- endif -%}  
            <div class="row">
              {%- render 'product-information',
                section_settings: section.settings,
                variant_colors: variant_colors, 
                block: block,
                section_id: section_id,
                forloop_content: section.blocks
              -%}
            </div>
          {%- if section.settings.show_content_container == true -%}
          </div>
          {%- endif -%}  
        </div>
      {%- else -%}
        {%- liquid
          if section.settings.product_gellery == 'grid-2-columns' and section.settings.container_type != 'container'
            assign col_class = 'col-lg-6 col-xl-7 col-xxl-8'
          else
            assign col_class = 'col-xl-7 col-lg-6'
          endif
        -%}
        <div class="product-gallery {{ col_class }} {{ section.settings.product_gellery }}{{ thumb_slider }} {%- if section.settings.show_thumb_slider == false -%}no-thumb{% endif %}" id="product-gallery-{{ section.id }}" data-group-image="{{ section.settings.enable_variant_group }}">
          <div class="position-sticky product-media-grid-wrapper mobille-media-slider d-flex flex-wrap {% if section.settings.product_gellery == 'slider-horizontal' %}flex-column {% endif %} w-100 product-{{ section.settings.product_page_style }}" style="top: var(--top-space);">
            {%- if section.settings.product_gellery == 'slider-vertical' or section.settings.product_gellery == 'slider-horizontal' -%}
              {%- render 'product-media',
                section_settings: section.settings,
                slider_veiw: slides_per_view,
                direction: direction,
                group_image: group_image,
                section_id: section_id,
                product_options_downcased: product_options_downcased
              -%} 
            {%- elsif section.settings.product_gellery == 'grid-2-columns' or section.settings.product_gellery == 'grid-1-columns' or section.settings.product_gellery == 'combined-grid' -%}
              {%- render 'product-media-grid-column',
                section_settings: section.settings,
                slider_veiw: slides_per_view,
                direction: direction,
                group_image: group_image,
                section_id: section_id,
                product_options_downcased: product_options_downcased
              -%}
            {%- endif -%}
          </div>
        </div>  
        <div class="col-lg-6 col-xl-5{% if section.settings.product_gellery == 'grid-2-columns' and section.settings.container_type != 'container' %} col-xxl-4{% endif %} product-summary">
          <div class="position-sticky" style="top: var(--top-space);">
            {%- render 'product-information',
              section_settings: section.settings,
              variant_colors: variant_colors, 
              block: block,
              section_id: section_id,
              forloop_content: section.blocks 
            -%}
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{%- comment -%} Tvastra product video popup: only renders when the product video metafield is set. {%- endcomment -%}
{%- liquid
  assign tvastra_product_video = product.metafields.custom.video.value
  if tvastra_product_video == blank
    assign tvastra_product_video = product.metafields.custom.product_video.value
  endif
  if tvastra_product_video == blank
    assign tvastra_product_video = product.metafields.custom.video_url.value
  endif
-%}
{%- if tvastra_product_video != blank -%}
  <div class="tvastra-video-float" data-tvastra-video-float>
    <button class="tvastra-video-float__trigger" type="button" aria-label="Open product video" aria-haspopup="dialog" aria-controls="TvastraProductVideo-{{ section.id }}">
      <span class="tvastra-video-float__video-wrap">
        {{ tvastra_product_video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, preload: 'metadata' }}
      </span>
      <span class="tvastra-video-float__play" aria-hidden="true">
        <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true"><path d="M8 5.5v13l10-6.5z"></path></svg>
      </span>
      <span class="tvastra-video-float__label">Watch video</span>
    </button>

    <div class="tvastra-video-modal" id="TvastraProductVideo-{{ section.id }}" data-tvastra-video-modal hidden>
      <div class="tvastra-video-modal__backdrop" data-tvastra-video-close></div>
      <div class="tvastra-video-modal__dialog" role="dialog" aria-modal="true" aria-label="Product video">
        <button class="tvastra-video-modal__close" type="button" aria-label="Close product video" data-tvastra-video-close>
          <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
        </button>
        <div class="tvastra-video-modal__video-wrap">
          {{ tvastra_product_video | video_tag: autoplay: false, loop: true, muted: false, controls: true, playsinline: true, preload: 'metadata' }}
        </div>
      </div>
    </div>
  </div>
  <style>
    .tvastra-video-float {
      position: fixed;
      z-index: 2147483000;
      right: 16px;
      bottom: 18px;
      width: 118px;
      max-width: calc(100vw - 32px);
    }

    .tvastra-video-float__trigger {
      position: relative;
      display: block;
      width: 100%;
      padding: 0;
      border: 0;
      background: #111;
      border-radius: 16px;
      overflow: hidden;
      box-shadow: 0 10px 28px rgba(0,0,0,.2);
      cursor: pointer;
      transform: translateZ(0);
      transition: transform .22s ease, box-shadow .22s ease;
      -webkit-tap-highlight-color: transparent;
    }

    .tvastra-video-float__trigger:hover {
      transform: translateY(-2px);
      box-shadow: 0 14px 32px rgba(0,0,0,.24);
    }

    .tvastra-video-float__video-wrap,
    .tvastra-video-float__video-wrap video {
      display: block;
      width: 100%;
      aspect-ratio: 3 / 4;
    }

    .tvastra-video-float__video-wrap video {
      height: auto;
      object-fit: cover;
      background: #111;
    }

    .tvastra-video-float__trigger::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(to top, rgba(0,0,0,.52), transparent 48%);
      pointer-events: none;
    }

    .tvastra-video-float__play {
      position: absolute;
      z-index: 2;
      top: 50%;
      left: 50%;
      display: grid;
      width: 38px;
      height: 38px;
      place-items: center;
      transform: translate(-50%, -50%);
      border-radius: 50%;
      background: rgba(255,255,255,.9);
      box-shadow: 0 4px 14px rgba(0,0,0,.18);
    }

    .tvastra-video-float__play svg {
      width: 17px;
      height: 17px;
      margin-left: 2px;
      fill: #111;
    }

    .tvastra-video-float__label {
      position: absolute;
      z-index: 2;
      right: 8px;
      bottom: 7px;
      left: 8px;
      overflow: hidden;
      color: #fff;
      font-size: 11px;
      font-weight: 600;
      line-height: 1.2;
      text-align: center;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .tvastra-video-modal {
      position: fixed;
      z-index: 2147483001;
      inset: 0;
      display: grid;
      place-items: center;
      padding: 20px;
    }

    .tvastra-video-modal[hidden] {
      display: none;
    }

    .tvastra-video-modal__backdrop {
      position: absolute;
      inset: 0;
      background: rgba(0,0,0,.82);
      -webkit-backdrop-filter: blur(8px);
      backdrop-filter: blur(8px);
      animation: tvastraVideoFadeIn .2s ease;
    }

    .tvastra-video-modal__dialog {
      position: relative;
      z-index: 1;
      width: min(92vw, 520px);
      max-height: 92vh;
      animation: tvastraVideoZoomIn .24s cubic-bezier(.2,.8,.2,1);
    }

    .tvastra-video-modal__video-wrap {
      display: flex;
      width: 100%;
      max-height: 92vh;
      justify-content: center;
      overflow: hidden;
      border-radius: 18px;
      background: #000;
      box-shadow: 0 28px 80px rgba(0,0,0,.38);
    }

    .tvastra-video-modal__video-wrap video {
      display: block;
      width: auto;
      max-width: 100%;
      height: auto;
      max-height: 92vh;
      object-fit: contain;
    }

    .tvastra-video-modal__close {
      position: absolute;
      z-index: 3;
      top: -12px;
      right: -12px;
      display: grid;
      width: 42px;
      height: 42px;
      padding: 0;
      place-items: center;
      border: 1px solid rgba(255,255,255,.28);
      border-radius: 50%;
      background: rgba(17,17,17,.9);
      color: #fff;
      cursor: pointer;
      box-shadow: 0 8px 22px rgba(0,0,0,.28);
      -webkit-tap-highlight-color: transparent;
    }

    .tvastra-video-modal__close svg {
      width: 20px;
      height: 20px;
      fill: none;
      stroke: currentColor;
      stroke-linecap: round;
      stroke-width: 2;
    }

    html.tvastra-video-lock,
    body.tvastra-video-lock {
      overflow: hidden !important;
    }

    @keyframes tvastraVideoFadeIn {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    @keyframes tvastraVideoZoomIn {
      from { opacity: 0; transform: scale(.96); }
      to { opacity: 1; transform: scale(1); }
    }

    @media (max-width: 575px) {
      .tvastra-video-float {
        right: 12px;
        bottom: 14px;
        width: 94px;
      }

      .tvastra-video-float__trigger {
        border-radius: 14px;
      }

      .tvastra-video-float__play {
        width: 34px;
        height: 34px;
      }

      .tvastra-video-float__play svg {
        width: 15px;
        height: 15px;
      }

      .tvastra-video-float__label {
        font-size: 10px;
      }

      .tvastra-video-modal {
        padding: 12px;
      }

      .tvastra-video-modal__dialog {
        width: min(96vw, 520px);
        max-height: 96vh;
      }

      .tvastra-video-modal__video-wrap {
        max-height: 96vh;
        border-radius: 14px;
      }

      .tvastra-video-modal__video-wrap video {
        max-height: 96vh;
      }

      .tvastra-video-modal__close {
        top: 8px;
        right: 8px;
        width: 38px;
        height: 38px;
      }
    }
  </style>
  <script>
    (function () {
      var root = document.querySelector('[data-tvastra-video-float]');
      if (!root || root.dataset.tvastraVideoBound === 'true') return;
      root.dataset.tvastraVideoBound = 'true';

      var trigger = root.querySelector('.tvastra-video-float__trigger');
      var modal = root.querySelector('[data-tvastra-video-modal]');
      var modalVideo = modal ? modal.querySelector('video') : null;
      var previewVideo = root.querySelector('.tvastra-video-float__video-wrap video');
      var closeButtons = root.querySelectorAll('[data-tvastra-video-close]');
      var lastFocused = null;

      function pause(video) {
        if (!video) return;
        try { video.pause(); } catch (error) {}
      }

      function openModal() {
        if (!modal) return;
        lastFocused = document.activeElement;
        modal.hidden = false;
        document.documentElement.classList.add('tvastra-video-lock');
        document.body.classList.add('tvastra-video-lock');
        pause(previewVideo);
        if (modalVideo) {
          modalVideo.currentTime = 0;
          try {
            var promise = modalVideo.play();
            if (promise && typeof promise.catch === 'function') promise.catch(function () {});
          } catch (error) {}
        }
        var closeButton = modal.querySelector('.tvastra-video-modal__close');
        if (closeButton) closeButton.focus({ preventScroll: true });
      }

      function closeModal() {
        if (!modal || modal.hidden) return;
        modal.hidden = true;
        pause(modalVideo);
        document.documentElement.classList.remove('tvastra-video-lock');
        document.body.classList.remove('tvastra-video-lock');
        if (previewVideo) {
          try {
            var previewPromise = previewVideo.play();
            if (previewPromise && typeof previewPromise.catch === 'function') previewPromise.catch(function () {});
          } catch (error) {}
        }
        if (lastFocused && typeof lastFocused.focus === 'function') {
          try { lastFocused.focus({ preventScroll: true }); } catch (error) { lastFocused.focus(); }
        }
      }

      if (previewVideo) {
        previewVideo.muted = true;
        previewVideo.playsInline = true;
        previewVideo.loop = true;
        var previewPromise = previewVideo.play();
        if (previewPromise && typeof previewPromise.catch === 'function') previewPromise.catch(function () {});
      }

      if (trigger) trigger.addEventListener('click', openModal);
      closeButtons.forEach(function (button) {
        button.addEventListener('click', closeModal);
      });

      document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape' && modal && !modal.hidden) closeModal();
      });
    })();
  </script>
{%- endif -%}

