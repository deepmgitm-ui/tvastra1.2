{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url | default: shop.url
  assign og_type = 'website'
  assign og_description = page_description | default: shop.description | default: shop.name

  if request.page_type == 'index'
    assign og_title = 'Tvastra Fit | Premium Gym Wear & Activewear India'
    assign og_description = 'Shop Tvastra Fit activewear online—premium gym wear, yoga tops, leggings and athleisure for men & women. Explore the latest styles and shop online today.'
  elsif request.page_type == 'page'
    case page.handle
      when 'about-us'
        assign og_title = 'About Tvastra Fit | Activewear Brand India'
        assign og_description = 'Learn about Tvastra Fit, a modern activewear brand for gym, yoga, training and everyday athleisure. Discover our approach to fit and style.'
      when 'contact'
        assign og_title = 'Contact Tvastra Fit | Get in Touch'
        assign og_description = 'Have a question about Tvastra Fit products, orders or support? Contact our team and we will help you with your query.'
      when 'wishlist'
        assign og_title = 'Wishlist | Tvastra Fit'
        assign og_description = 'Save your favourite Tvastra Fit activewear styles and come back to them whenever you are ready to shop.'
      when 'kp-account'
        assign og_title = 'Account | Tvastra Fit'
        assign og_description = 'Manage your Tvastra Fit account and access your customer information.'
    endcase
  elsif request.page_type == 'blog' and blog.articles_count == 0
    assign og_title = 'Tvastra Fit Journal | Activewear & Fitness'
    assign og_description = 'Tvastra Fit journal for activewear, training, gym, yoga and everyday athleisure tips.'
  endif

  assign og_image = page_image
  if og_image == blank and request.page_type == 'product'
    assign og_image = product.featured_image
  endif
  if og_image == blank
    assign og_image = settings.logo
  endif
  assign og_image_url = ''
  if og_image != blank
    assign og_image_url = og_image | image_url: width: 1200 | prepend: 'https:'
  endif

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'collection'
    assign og_type = 'product.group'
  elsif request.page_type == 'password'
    assign og_url = shop.url
  endif

  assign should_noindex = false
  if request.page_type == 'search'
    assign should_noindex = true
  elsif request.page_type == 'cart'
    assign should_noindex = true
  elsif request.page_type == 'password'
    assign should_noindex = true
  elsif request.page_type == 'page' and page.handle == 'wishlist'
    assign should_noindex = true
  elsif request.page_type == 'page' and page.handle == 'kp-account'
    assign should_noindex = true
  elsif request.page_type == 'blog' and blog.articles_count == 0
    assign should_noindex = true
  endif
-%}

<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:url" content="{{ og_url | escape }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description | strip_html | escape }}">
<meta property="og:locale" content="{{ request.locale.iso_code | replace: '-', '_' }}">
{%- if og_image_url != blank -%}
  <meta property="og:image" content="{{ og_image_url }}">
  <meta property="og:image:secure_url" content="{{ og_image_url }}">
  <meta property="og:image:width" content="{{ og_image.width | default: 1200 }}">
  <meta property="og:image:height" content="{{ og_image.height | default: 1200 }}">
  <meta property="og:image:alt" content="{{ og_title | escape }}">
{%- endif -%}
{%- if request.page_type == 'product' -%}
  <meta property="product:price:amount" content="{{ product.price | money_without_currency | strip_html | escape }}">
  <meta property="product:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif -%}
{%- if settings.social_twitter_link != blank -%}
  <meta name="twitter:site" content="{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' | escape }}">
{%- endif -%}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | strip_html | escape }}">
{%- if og_image_url != blank -%}
  <meta name="twitter:image" content="{{ og_image_url }}">
  <meta name="twitter:image:alt" content="{{ og_title | escape }}">
{%- endif -%}
{%- if should_noindex -%}
  <meta name="robots" content="noindex,follow">
{%- else -%}
  <meta name="robots" content="index,follow">
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": {{ shop.url | json }}
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": {{ product.title | json }},
        "item": {{ canonical_url | json }}
      }
    ]
  }
  </script>
{%- elsif request.page_type == 'collection' -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": {{ shop.url | json }}
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": {{ collection.title | json }},
        "item": {{ canonical_url | json }}
      }
    ]
  }
  </script>
{%- elsif request.page_type == 'article' -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": {{ shop.url | json }}
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": {{ blog.title | json }},
        "item": {{ blog.url | prepend: shop.url | json }}
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": {{ article.title | json }},
        "item": {{ canonical_url | json }}
      }
    ]
  }
  </script>
{%- elsif request.page_type == 'page' and page.handle != 'kp-account' and page.handle != 'wishlist' -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": {{ shop.url | json }}
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": {{ page.title | json }},
        "item": {{ canonical_url | json }}
      }
    ]
  }
  </script>
{%- endif -%}
