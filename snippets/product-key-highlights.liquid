{%- liquid
  assign tvastra_highlights_field = product.metafields.custom.key_highlights
  assign tvastra_highlights_title = product.metafields.custom.key_highlights_title.value | default: 'Key Highlights'
  assign tvastra_highlights_type = tvastra_highlights_field.type
  assign tvastra_highlights_items = tvastra_highlights_field.value
-%}

{%- if tvastra_highlights_field != blank and tvastra_highlights_items != blank -%}
  <style>
    .tvastra-key-highlights {
      position: absolute;
      z-index: 4;
      inset: 0;
      display: flex;
      align-items: flex-start;
      padding: clamp(24px, 5vw, 58px) clamp(20px, 5vw, 54px);
      pointer-events: none;
      overflow: hidden;
      border-radius: inherit;
      background: linear-gradient(90deg, rgba(10,10,10,.76) 0%, rgba(10,10,10,.52) 30%, rgba(10,10,10,.12) 60%, rgba(10,10,10,0) 80%);
      color: #fff;
    }
    .tvastra-key-highlights__inner {
      width: min(43%, 390px);
      max-width: 100%;
    }
    .tvastra-key-highlights__title {
      margin: 0 0 clamp(22px, 4vw, 34px);
      font-size: clamp(30px, 3.2vw, 46px);
      font-weight: 700;
      line-height: 1.04;
      letter-spacing: -.03em;
      text-transform: none;
      opacity: 0;
      transform: translateX(-34px);
    }
    .tvastra-key-highlights--visible .tvastra-key-highlights__title {
      animation: tvastraHighlightsTitle .65s cubic-bezier(.2,.75,.2,1) .08s forwards;
    }
    .tvastra-key-highlights__item {
      padding: 0 0 13px;
      margin: 0 0 13px;
      border-bottom: 1px solid rgba(255,255,255,.34);
      opacity: 0;
      transform: translateX(-34px);
    }
    .tvastra-key-highlights--visible .tvastra-key-highlights__item {
      animation: tvastraHighlightsItem .58s cubic-bezier(.2,.75,.2,1) calc(.22s + var(--tvastra-highlight-delay, 0s)) forwards;
    }
    .tvastra-key-highlights__label {
      display: block;
      margin: 0 0 3px;
      color: rgba(255,255,255,.72);
      font-size: clamp(11px, 1.1vw, 15px);
      font-weight: 400;
      line-height: 1.25;
    }
    .tvastra-key-highlights__value {
      display: block;
      color: #fff;
      font-size: clamp(15px, 1.55vw, 22px);
      font-weight: 700;
      line-height: 1.2;
    }
    @keyframes tvastraHighlightsTitle {
      to { opacity: 1; transform: translateX(0); }
    }
    @keyframes tvastraHighlightsItem {
      to { opacity: 1; transform: translateX(0); }
    }
    @media (max-width: 767px) {
      .tvastra-key-highlights {
        padding: 28px 20px 24px;
        align-items: flex-start;
        background: linear-gradient(90deg, rgba(10,10,10,.76) 0%, rgba(10,10,10,.48) 44%, rgba(10,10,10,.07) 76%, rgba(10,10,10,0) 100%);
      }
      .tvastra-key-highlights__inner { width: min(62%, 270px); }
      .tvastra-key-highlights__title {
        margin-bottom: 22px;
        font-size: clamp(28px, 9vw, 40px);
      }
      .tvastra-key-highlights__item { padding-bottom: 10px; margin-bottom: 10px; }
      .tvastra-key-highlights__label { font-size: 12px; }
      .tvastra-key-highlights__value { font-size: 16px; }
    }
    @media (prefers-reduced-motion: reduce) {
      .tvastra-key-highlights__title,
      .tvastra-key-highlights__item {
        opacity: 1;
        transform: none;
        animation: none !important;
      }
    }
  </style>

  <div class="tvastra-key-highlights" aria-label="Key Highlights">
    <div class="tvastra-key-highlights__inner">
      <h2 class="tvastra-key-highlights__title">{{ tvastra_highlights_title | escape | newline_to_br }}</h2>

      {%- if tvastra_highlights_type == 'list.single_line_text_field' -%}
        {%- for highlight in tvastra_highlights_items -%}
          {%- assign highlight_parts = highlight | split: '|' -%}
          {%- assign highlight_label = highlight_parts[0] | strip -%}
          {%- assign highlight_value = highlight_parts[1] | default: highlight_parts[0] | strip -%}
          {%- if highlight_value != blank -%}
            <div class="tvastra-key-highlights__item" style="--tvastra-highlight-delay: {{ forloop.index0 | times: 0.12 }}s;">
              {%- if highlight_parts.size > 1 and highlight_label != blank -%}<span class="tvastra-key-highlights__label">{{ highlight_label | escape }}</span>{%- endif -%}
              <span class="tvastra-key-highlights__value">{{ highlight_value | escape }}</span>
            </div>
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        {%- assign highlight_lines = tvastra_highlights_items | newline_to_br | split: '<br />' -%}
        {%- for highlight in highlight_lines -%}
          {%- assign highlight_parts = highlight | split: '|' -%}
          {%- assign highlight_label = highlight_parts[0] | strip -%}
          {%- assign highlight_value = highlight_parts[1] | default: highlight_parts[0] | strip -%}
          {%- if highlight_value != blank -%}
            <div class="tvastra-key-highlights__item" style="--tvastra-highlight-delay: {{ forloop.index0 | times: 0.12 }}s;">
              {%- if highlight_parts.size > 1 and highlight_label != blank -%}<span class="tvastra-key-highlights__label">{{ highlight_label | escape }}</span>{%- endif -%}
              <span class="tvastra-key-highlights__value">{{ highlight_value | escape }}</span>
            </div>
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>

  <script>
    (function () {
      function setupHighlights() {
        document.querySelectorAll('.tvastra-key-highlights').forEach(function (highlights) {
          if (highlights.dataset.tvastraBound === 'true') return;
          highlights.dataset.tvastraBound = 'true';

          var slide = highlights.closest('.product__media-item');
          if (!slide) return;

          function sync() {
            var active = slide.classList.contains('swiper-slide-active');
            highlights.classList.toggle('tvastra-key-highlights--visible', active);
          }

          sync();

          if (window.MutationObserver) {
            new MutationObserver(sync).observe(slide, { attributes: true, attributeFilter: ['class'] });
          }
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setupHighlights);
      } else {
        setupHighlights();
      }

      window.addEventListener('load', setupHighlights);
    })();
  </script>
{%- endif -%}
